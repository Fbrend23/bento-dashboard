{
  "name": "bento-dashboard",
  "version": "1.3.0",
  "productName": "Bento Dashboard",
  "private": true,
  "description": "Tableau de bord Electron pour surveiller et piloter le serveur bento via Tailscale",
  "main": "./out/main/index.js",
  "author": "Brendan Fleurdelys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fbrend23/bento-dashboard.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build:win && node scripts/publish-release.mjs",
    "build:agent": "vite build -c vite.agent.config.ts",
    "build:mobile": "vue-tsc --noEmit -p tsconfig.web.json --composite false && vite build -c vite.mobile.config.ts",
    "package:agent": "node scripts/package-agent.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "electron-updater": "^6.8.9",
    "pinia": "^3.0.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
