[Unit]
Description=Bento agent (page du téléphone et actions sur les conteneurs)
After=network-online.target docker.service
# Au bout de 5 échecs en une minute, systemd renonce au lieu de boucler à l'infini.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bento-dash
Environment=BENTO_AGENT_CONFIG=/etc/bento-agent/config.json
Environment=BENTO_AGENT_STATIC=/opt/bento-agent/public
# L'historique (relevés d'une minute sur 7 jours, incidents) que l'app de bureau lit en SSH.
# StateDirectory crée /var/lib/bento-agent pour bento-dash, et reste inscriptible malgré ProtectSystem.
StateDirectory=bento-agent
Environment=BENTO_AGENT_HISTORY=/var/lib/bento-agent/history.json
ExecStart=/usr/bin/node /opt/bento-agent/bento-agent.cjs
Restart=on-failure
RestartSec=5

# Durcissement. Chaque commande passe par `sudo -n` (règles sudoers exactes) : NE PAS ajouter
# NoNewPrivileges, RestrictSUIDSGID, CapabilityBoundingSet ni ProtectSystem=strict, qui casseraient
# sudo sans message clair.
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
